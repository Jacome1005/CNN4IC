`timescale 1 ns/ 1 ns
//=======================================================
//  TB_SYSTEM — Testbench completo: SPI + CNN integrado
//=======================================================
//  Protocolo SPI (2-bit cmd + data):
//    00 = LOAD IMAGE   (10 filas x 30 bits = 300 bits)
//    01 = LOAD WEIGHTS ( 5 filas x 15 bits =  75 bits) ★
//    10 = START CNN
//    11 = READ RESULT  (11 clocks -> MISO)
//
//  Cambios respecto a version anterior (marcados con ★):
//  ★A  test_weight -> [14:0] x 5 filas (kernel 5x5 x 3bits = 75 bits)
//  ★B  Nueva tarea send_weight_row (15 bits MSB first)
//  ★C  spi_load_weights envia 5 filas x 15 bits
//  ★D  compute_expected: w_flat={wt[4..0]}, indice px corregido (parche 5x5)
//  ★E  Wire paths actualizados (_routing_cwire -> _cwire)
//  ★F  CNNver2_Reset_InHigh conectado como puerto real (reg TB_SYSTEM_RESET)
//  ★G  TEST 2,4,5,6,7,8,12 actualizados para pesos 15 bits x 5 filas
//=======================================================

module TB_SYSTEM();

// ============================================
// Parameters
// ============================================
    parameter TCK            = 20;

    // Imagen 10x10 x 3 bits
    parameter IMG_ROWS       = 10;
    parameter IMG_COLS       = 10;
    parameter BITS_PER_POS   = 3;
    parameter ROW_BITS       = IMG_COLS * BITS_PER_POS;    // 30
    parameter IMG_TOTAL_BITS = IMG_ROWS * ROW_BITS;        // 300

    // ★A Kernel 5x5 x 3 bits
    parameter KERN_SIZE      = 5;
    parameter WGT_ROWS       = KERN_SIZE;                  // 5
    parameter WGT_ROW_BITS   = KERN_SIZE * BITS_PER_POS;  // 15
    parameter WGT_TOTAL_BITS = WGT_ROWS * WGT_ROW_BITS;   // 75

    integer ii = 0;
    integer jj = 0;
    integer pass_count = 0;
    integer fail_count = 0;

// ============================================
// WIRE / REG DECLARATIONS
// ============================================
    wire        TB_SYSTEM_MISO;
    reg         TB_SYSTEM_CLOCK_50;
    reg         TB_SYSTEM_SS_N;
    reg         TB_SYSTEM_MOSI;
    reg         TB_SYSTEM_RESET;             // ★F

    reg [ROW_BITS-1:0]     test_image  [0:IMG_ROWS-1]; // 10 x 30 bits
    reg [WGT_ROW_BITS-1:0] test_weight [0:WGT_ROWS-1]; // ★A 5 x 15 bits
    reg [10:0]             miso_captured;

// ============================================
// UUT INSTANTIATION
// ============================================
    // ★F CNNver2_Reset_InHigh ahora es puerto real
    CNNver2 CNNver2_u0 (
        .CNNver2_SPICLOCK_50 (TB_SYSTEM_CLOCK_50),
        .CNNver2_SS_N        (TB_SYSTEM_SS_N),
        .CNNver2_MOSI        (TB_SYSTEM_MOSI),
        .CNNver2_MISO        (TB_SYSTEM_MISO),
        .CNNver2_Reset_InHigh(TB_SYSTEM_RESET)  // ★F
    );

// ============================================
// INITIAL: Setup de senales
// ============================================
initial begin
    TB_SYSTEM_CLOCK_50 <= 0;
    TB_SYSTEM_SS_N     <= 1'b1;
    TB_SYSTEM_MOSI     <= 1'b0;
    TB_SYSTEM_RESET    <= 1'b0;   // ★F
end

// ============================================
// CLOCK — 50 MHz (periodo 20 ns)
// ============================================
always
    #(TCK/2) TB_SYSTEM_CLOCK_50 <= ~TB_SYSTEM_CLOCK_50;

// ============================================
// TASK: Send SPI Command (2 bits, MSB first)
// ============================================
task send_cmd;
    input [1:0] cmd_in;
    begin
        @(negedge TB_SYSTEM_CLOCK_50); #2; TB_SYSTEM_MOSI <= cmd_in[1];
        @(posedge TB_SYSTEM_CLOCK_50); #1;
        @(negedge TB_SYSTEM_CLOCK_50); #2; TB_SYSTEM_MOSI <= cmd_in[0];
        @(posedge TB_SYSTEM_CLOCK_50); #1;
    end
endtask

// ============================================
// TASK: Send SPI Row imagen (30 bits, MSB first)
// ============================================
task send_row;
    input [ROW_BITS-1:0] row_in;
    begin
        for (jj = ROW_BITS-1; jj >= 0; jj = jj - 1) begin
            @(negedge TB_SYSTEM_CLOCK_50); #2;
            TB_SYSTEM_MOSI = row_in[jj];
            @(posedge TB_SYSTEM_CLOCK_50); #1;
        end
    end
endtask

// ★B TASK: Send SPI Weight Row (15 bits, MSB first)
task send_weight_row;
    input [WGT_ROW_BITS-1:0] wrow_in;
    begin
        for (jj = WGT_ROW_BITS-1; jj >= 0; jj = jj - 1) begin
            @(negedge TB_SYSTEM_CLOCK_50); #2;
            TB_SYSTEM_MOSI = wrow_in[jj];
            @(posedge TB_SYSTEM_CLOCK_50); #1;
        end
    end
endtask

// ============================================
// TASK: SPI — LOAD IMAGE (cmd 00)
//   10 filas x 30 bits = 300 bits
// ============================================
task spi_load_image;
    begin
        @(negedge TB_SYSTEM_CLOCK_50); #2;
        TB_SYSTEM_SS_N <= 1'b0;
        send_cmd(2'b00);
        for (ii = 0; ii < IMG_ROWS; ii = ii + 1)
            send_row(test_image[ii]);
        #(TCK);
        @(negedge TB_SYSTEM_CLOCK_50); #2;
        TB_SYSTEM_SS_N <= 1'b1;
        #(TCK*5);
    end
endtask

// ★C TASK: SPI — LOAD WEIGHTS (cmd 01)
//   5 filas x 15 bits = 75 bits
task spi_load_weights;
    begin
        @(negedge TB_SYSTEM_CLOCK_50); #2;
        TB_SYSTEM_SS_N <= 1'b0;
        send_cmd(2'b01);
        for (ii = 0; ii < WGT_ROWS; ii = ii + 1)  // ★C 5 filas
            send_weight_row(test_weight[ii]);       // ★C 15 bits por fila
        #(TCK);
        @(negedge TB_SYSTEM_CLOCK_50); #2;
        TB_SYSTEM_SS_N <= 1'b1;
        #(TCK*5);
    end
endtask

// ============================================
// TASK: SPI — START CNN (cmd 10)
// ============================================
task spi_start_cnn;
    begin
        @(negedge TB_SYSTEM_CLOCK_50); #2;
        TB_SYSTEM_SS_N <= 1'b0;
        send_cmd(2'b10);
        for (ii = 0; ii < 4; ii = ii + 1) begin
            @(negedge TB_SYSTEM_CLOCK_50); #2;
            TB_SYSTEM_MOSI <= 1'b0;
            @(posedge TB_SYSTEM_CLOCK_50); #1;
        end
        @(negedge TB_SYSTEM_CLOCK_50); #2;
        TB_SYSTEM_SS_N <= 1'b1;
        #(TCK*10);
    end
endtask

// ============================================
// TASK: SPI — READ RESULT (cmd 11)
//   Captura 11 bits por MISO (MSB primero)
// ============================================
task spi_read_result;
    begin
        miso_captured = 11'd0;
        @(negedge TB_SYSTEM_CLOCK_50); #2;
        TB_SYSTEM_SS_N <= 1'b0;
        send_cmd(2'b11);
        // 1er clock: activa miso_active, captura bit 10
        @(negedge TB_SYSTEM_CLOCK_50); #2; TB_SYSTEM_MOSI <= 1'b0;
        @(posedge TB_SYSTEM_CLOCK_50); #1; #2;
        miso_captured[10] = TB_SYSTEM_MISO;
        // Siguientes 10 clocks: bits [9:0]
        for (ii = 9; ii >= 0; ii = ii - 1) begin
            @(negedge TB_SYSTEM_CLOCK_50); #2; TB_SYSTEM_MOSI <= 1'b0;
            @(posedge TB_SYSTEM_CLOCK_50); #1; #2;
            miso_captured[ii] = TB_SYSTEM_MISO;
        end
        @(negedge TB_SYSTEM_CLOCK_50); #2;
        TB_SYSTEM_SS_N <= 1'b1;
        #(TCK*5);
    end
endtask

// ★D TASK: compute_expected
//   Calcula la convolucion 5x5 en posicion (R_OFF=0, C_OFF=0):
//
//   Sum(k=0..24): pixel(k/5, k%5) x weight(k)
//
//   px_flat layout (igual que cnn_v2 y CNNver2):
//     fila r = px_flat[r*30 +: 30]
//     pixel (r,c) = px_flat[r*30 + c*3 +: 3]
//
//   w_flat layout (igual que w_flat_cwire en CNNver2):
//     peso k = w_flat[k*3 +: 3]
//     (fila 0 del kernel en bits bajos, fila 4 en bits altos)
//=======================================================
reg signed [10:0] expected_y;

task compute_expected;
    reg [IMG_TOTAL_BITS-1:0] px_flat;  // 300 bits
    reg [WGT_TOTAL_BITS-1:0] w_flat;  // ★D 75 bits exactos (5x15)
    reg signed [2:0] px_k;
    reg signed [2:0] w_k;
    reg signed [10:0] acc;
    integer k, bit_off_px;
    begin
        // Empaquetar imagen: fila 0 en bits bajos
        px_flat = {
            test_image[9], test_image[8],
            test_image[7], test_image[6],
            test_image[5], test_image[4],
            test_image[3], test_image[2],
            test_image[1], test_image[0]
        };

        // ★D Empaquetar pesos: fila 0 en bits bajos
        //   Coincide con w_flat_cwire = {wt4, wt3, wt2, wt1, wt0}
        w_flat = {
            test_weight[4], test_weight[3], test_weight[2],
            test_weight[1], test_weight[0]
        };

        acc = 11'sd0;
        for (k = 0; k < 25; k = k + 1) begin
            // ★D Parche 5x5 en R_OFF=0, C_OFF=0:
            //   pixel en fila k/5, col k%5 de la imagen
            bit_off_px = (k/5)*30 + (k%5)*3;
            px_k = $signed(px_flat[bit_off_px +: 3]);
            w_k  = $signed(w_flat[k*3 +: 3]);
            acc  = acc + (px_k * w_k);
        end
        expected_y = acc;
    end
endtask

// ============================================
// TASK: check_result — compara y reporta
// ============================================
task check_result;
    input [79:0] test_name;
    begin
        compute_expected;
        // ★E Wire names actualizados
        $display("  CNN y_out   = %0d (signed)", $signed(CNNver2_u0.CNN_y_out_cwire));
        $display("  Result Reg  = %0d (signed)", $signed(CNNver2_u0.CNN_Result_out_cwire));
        $display("  Expected    = %0d", $signed(expected_y));
        $display("  MISO[10:0]  = %0d (signed)", $signed(miso_captured));
        if ($signed(CNNver2_u0.CNN_Result_out_cwire) === expected_y) begin
            $display("  >> PASS");
            pass_count = pass_count + 1;
        end else begin
            $display("  >> FAIL (got %0d, expected %0d)",
                $signed(CNNver2_u0.CNN_Result_out_cwire), $signed(expected_y));
            fail_count = fail_count + 1;
        end
    end
endtask

// ============================================
// STIMULUS PROCESS
// ============================================
initial begin
    $display("===================================================");
    $display("  TB CNNver2 - SPI + CNN Integration Testbench");
    $display("===================================================");
    $display("  Imagen:  10 filas x 30 bits = 300 bits total");
    $display("  Kernel:   5 filas x 15 bits =  75 bits total"); // ★
    $display("  Convolucion 5x5 en posicion (R_OFF=0, C_OFF=0)");
    $display("===================================================");

    #(TCK*10);

    // ★F Reset via puerto real
    TB_SYSTEM_RESET <= 1'b1;
    #40;
    TB_SYSTEM_RESET <= 1'b0;
    #(TCK*3);

    // =========================================================
    // TEST 1: SPI Image Load — 10 registros de 30 bits
    // =========================================================
    $display("");
    $display("--- TEST 1: SPI LOAD IMAGE (10 filas x 30 bits) ---");

    test_image[0] = 30'h00000001;
    test_image[1] = 30'h00000249;
    test_image[2] = 30'h3FFFFFFF;
    test_image[3] = 30'h15555555;
    test_image[4] = 30'h00000000;
    test_image[5] = 30'h09249249;
    test_image[6] = 30'h1BBBBBBB;
    test_image[7] = 30'h0AAAAAAA;
    test_image[8] = 30'h12345678;
    test_image[9] = 30'h0FEDCBA9;

    spi_load_image();

    $display("VERIFICACION DE REGISTROS (Hardware Output):");
    $display("  Reg0: %h (Exp: %h)", CNNver2_u0.register_imag_u0.Register_Imag_DataOutBUS, test_image[0]);
    $display("  Reg1: %h (Exp: %h)", CNNver2_u0.register_imag_u1.Register_Imag_DataOutBUS, test_image[1]);
    $display("  Reg2: %h (Exp: %h)", CNNver2_u0.register_imag_u2.Register_Imag_DataOutBUS, test_image[2]);
    $display("  Reg3: %h (Exp: %h)", CNNver2_u0.register_imag_u3.Register_Imag_DataOutBUS, test_image[3]);
    $display("  Reg4: %h (Exp: %h)", CNNver2_u0.register_imag_u4.Register_Imag_DataOutBUS, test_image[4]);
    $display("  Reg5: %h (Exp: %h)", CNNver2_u0.register_imag_u5.Register_Imag_DataOutBUS, test_image[5]);
    $display("  Reg6: %h (Exp: %h)", CNNver2_u0.register_imag_u6.Register_Imag_DataOutBUS, test_image[6]);
    $display("  Reg7: %h (Exp: %h)", CNNver2_u0.register_imag_u7.Register_Imag_DataOutBUS, test_image[7]);
    $display("  Reg8: %h (Exp: %h)", CNNver2_u0.register_imag_u8.Register_Imag_DataOutBUS, test_image[8]);
    $display("  Reg9: %h (Exp: %h)", CNNver2_u0.register_imag_u9.Register_Imag_DataOutBUS, test_image[9]);
    $display("---------------------------------------------------");

    if (CNNver2_u0.register_imag_u0.Register_Imag_DataOutBUS == test_image[0] &&
        CNNver2_u0.register_imag_u1.Register_Imag_DataOutBUS == test_image[1] &&
        CNNver2_u0.register_imag_u2.Register_Imag_DataOutBUS == test_image[2] &&
        CNNver2_u0.register_imag_u3.Register_Imag_DataOutBUS == test_image[3] &&
        CNNver2_u0.register_imag_u4.Register_Imag_DataOutBUS == test_image[4] &&
        CNNver2_u0.register_imag_u5.Register_Imag_DataOutBUS == test_image[5] &&
        CNNver2_u0.register_imag_u6.Register_Imag_DataOutBUS == test_image[6] &&
        CNNver2_u0.register_imag_u7.Register_Imag_DataOutBUS == test_image[7] &&
        CNNver2_u0.register_imag_u8.Register_Imag_DataOutBUS == test_image[8] &&
        CNNver2_u0.register_imag_u9.Register_Imag_DataOutBUS == test_image[9]) begin
        $display("  >> TEST 1 PASSED");
        pass_count = pass_count + 1;
    end else begin
        $display("  >> TEST 1 FAILED");
        fail_count = fail_count + 1;
    end

    // =========================================================
    // TEST 2: SPI Weight Load — ★G 5 filas x 15 bits
    // =========================================================
    $display("");
    $display("--- TEST 2: SPI LOAD WEIGHTS (5 filas x 15 bits) ---");

    // ★G Valores de 15 bits — cada uno es 5 pesos x 3 bits
    //   15'h0249 = 000_010_100_100_101 ... mejor: 001_001_001_001_001 = 0x0249
    test_weight[0] = 15'h0001;  // 000_000_000_000_001
    test_weight[1] = 15'h0249;  // 001_001_001_001_001 (+1 por cada peso)
    test_weight[2] = 15'h1FFF;  // 011_111_111_111_111
    test_weight[3] = 15'h06DB;  // 000_110_110_110_011 -> 011_011_011_011_011 (+3 x 5)
    test_weight[4] = 15'h0000;  // todo cero

    spi_load_weights();

    $display("VERIFICACION weight_mem interno del SPI:");
    $display("  wmem[0]: %h (Exp: %h)", CNNver2_u0.spi_cnn_slave_8_u0.weight_mem[0], test_weight[0]);
    $display("  wmem[1]: %h (Exp: %h)", CNNver2_u0.spi_cnn_slave_8_u0.weight_mem[1], test_weight[1]);
    $display("  wmem[2]: %h (Exp: %h)", CNNver2_u0.spi_cnn_slave_8_u0.weight_mem[2], test_weight[2]);
    $display("  wmem[3]: %h (Exp: %h)", CNNver2_u0.spi_cnn_slave_8_u0.weight_mem[3], test_weight[3]);
    $display("  wmem[4]: %h (Exp: %h)", CNNver2_u0.spi_cnn_slave_8_u0.weight_mem[4], test_weight[4]);

    if (CNNver2_u0.spi_cnn_slave_8_u0.weight_mem[0] == test_weight[0] &&
        CNNver2_u0.spi_cnn_slave_8_u0.weight_mem[1] == test_weight[1] &&
        CNNver2_u0.spi_cnn_slave_8_u0.weight_mem[2] == test_weight[2] &&
        CNNver2_u0.spi_cnn_slave_8_u0.weight_mem[3] == test_weight[3] &&
        CNNver2_u0.spi_cnn_slave_8_u0.weight_mem[4] == test_weight[4]) begin
        $display("  >> TEST 2 PASSED");
        pass_count = pass_count + 1;
    end else begin
        $display("  >> TEST 2 FAILED");
        fail_count = fail_count + 1;
    end

    // =========================================================
    // TEST 3: CNN completo — Todo Ceros
    //   Esperado: 0
    // =========================================================
    $display("");
    $display("--- TEST 3: CNN flujo completo - Todo Ceros (Exp: 0) ---");

    for (ii = 0; ii < IMG_ROWS; ii = ii + 1)
        test_image[ii]  = 30'h00000000;
    for (ii = 0; ii < WGT_ROWS; ii = ii + 1)   // ★G 5 filas
        test_weight[ii] = 15'h0000;

    spi_load_image();
    spi_load_weights();
    spi_start_cnn();
    spi_read_result();
    check_result("ZEROS");

    // =========================================================
    // TEST 4: CNN — imagen -1 / pesos -1
    //   3-bit 111 = -1 signed. 25 terminos: (-1)x(-1)=+1 -> Exp: +25
    // =========================================================
    $display("");
    $display("--- TEST 4: CNN - imagen -1 / pesos -1 (Exp: +25) ---");

    // 30 bits todos 1 = 10 pixels x 111 = -1
    for (ii = 0; ii < IMG_ROWS; ii = ii + 1)
        test_image[ii]  = 30'h3FFFFFFF;
    // 15 bits todos 1 = 5 pesos x 111 = -1 (x5 filas) ★G
    for (ii = 0; ii < WGT_ROWS; ii = ii + 1)
        test_weight[ii] = 15'h7FFF;

    spi_load_image();
    spi_load_weights();
    spi_start_cnn();
    spi_read_result();
    check_result("ALL_NEG1");

    // =========================================================
    // TEST 5: CNN — patron +1 uniforme
    //   Pixel 001=+1, Peso 001=+1. 25 terminos -> Exp: +25
    // =========================================================
    $display("");
    $display("--- TEST 5: CNN - patron +1 uniforme (Exp: +25) ---");

    // 30 bits: 001 repetido 10 veces = 30'h09249249
    for (ii = 0; ii < IMG_ROWS; ii = ii + 1)
        test_image[ii] = 30'h09249249;
    // 15 bits: 001 repetido 5 veces = 15'h0249 ★G
    for (ii = 0; ii < WGT_ROWS; ii = ii + 1)
        test_weight[ii] = 15'h0249;

    spi_load_image();
    spi_load_weights();
    spi_start_cnn();
    spi_read_result();
    check_result("UNI_001");

    // =========================================================
    // TEST 6: CNN — imagen +1, pesos -1
    //   25 terminos: (+1)x(-1)=-1 -> Exp: -25
    // =========================================================
    $display("");
    $display("--- TEST 6: CNN - imagen +1, pesos -1 (Exp: -25) ---");

    for (ii = 0; ii < IMG_ROWS; ii = ii + 1)
        test_image[ii] = 30'h09249249;   // +1 por pixel
    for (ii = 0; ii < WGT_ROWS; ii = ii + 1)  // ★G
        test_weight[ii] = 15'h7FFF;      // 111 x 5 = -1 por peso

    spi_load_image();
    spi_load_weights();
    spi_start_cnn();
    spi_read_result();
    check_result("POS_NEG");

    // =========================================================
    // TEST 7: CNN — patron mixto arbitrario
    //   compute_expected calcula el valor correcto automaticamente
    // =========================================================
    $display("");
    $display("--- TEST 7: CNN - patron mixto arbitrario ---");

    test_image[0] = 30'h2A5A5A5A; test_image[1] = 30'h13C3C3C3;
    test_image[2] = 30'h0A96969A; test_image[3] = 30'h3FFFFFFF;
    test_image[4] = 30'h00000000; test_image[5] = 30'h155D55D5;
    test_image[6] = 30'h2AAAAAAA; test_image[7] = 30'h00000001;
    test_image[8] = 30'h12481248; test_image[9] = 30'h0DB6DB6D;

    // ★G 5 filas x 15 bits — valores arbitrarios para coverage
    test_weight[0] = 15'h16B5;  // mezcla de positivos y negativos
    test_weight[1] = 15'h0492;
    test_weight[2] = 15'h7FFF;  // -1 x 5
    test_weight[3] = 15'h0000;  // cero x 5
    test_weight[4] = 15'h36DB;  // 011 x 5 = +3 x 5

    spi_load_image();
    spi_load_weights();
    spi_start_cnn();
    spi_read_result();
    check_result("MIXED");

    // =========================================================
    // TEST 8: Verificar weight registers post-CNN
    //   Los Register_Weight deben retener los valores de TEST 7
    //   ★G Puerto correcto: Register_Weight_DataOutBUS
    //      Solo existen u0..u4 (kernel 5x5)
    // =========================================================
    $display("");
    $display("--- TEST 8: Verificar weight registers post-CNN ---");

    $display("  WReg0: %h (Exp: %h)",
        CNNver2_u0.weight_register_u0.Register_Weight_DataOutBUS, test_weight[0]);
    $display("  WReg1: %h (Exp: %h)",
        CNNver2_u0.weight_register_u1.Register_Weight_DataOutBUS, test_weight[1]);
    $display("  WReg2: %h (Exp: %h)",
        CNNver2_u0.weight_register_u2.Register_Weight_DataOutBUS, test_weight[2]);
    $display("  WReg3: %h (Exp: %h)",
        CNNver2_u0.weight_register_u3.Register_Weight_DataOutBUS, test_weight[3]);
    $display("  WReg4: %h (Exp: %h)",
        CNNver2_u0.weight_register_u4.Register_Weight_DataOutBUS, test_weight[4]);

    if (CNNver2_u0.weight_register_u0.Register_Weight_DataOutBUS == test_weight[0] &&
        CNNver2_u0.weight_register_u1.Register_Weight_DataOutBUS == test_weight[1] &&
        CNNver2_u0.weight_register_u2.Register_Weight_DataOutBUS == test_weight[2] &&
        CNNver2_u0.weight_register_u3.Register_Weight_DataOutBUS == test_weight[3] &&
        CNNver2_u0.weight_register_u4.Register_Weight_DataOutBUS == test_weight[4]) begin
        $display("  >> TEST 8 PASSED");
        pass_count = pass_count + 1;
    end else begin
        $display("  >> TEST 8 FAILED");
        fail_count = fail_count + 1;
    end

    // =========================================================
    // TEST 9: FSM CNN Controller — secuencia de estados
    // =========================================================
    $display("");
    $display("--- TEST 9: FSM CNN Controller states ---");
    $display("  Estado actual: %0d (esperado: 0=IDLE)",
        CNNver2_u0.cnn_ctrl_sm.STATE_Register);

    for (ii = 0; ii < IMG_ROWS; ii = ii + 1)
        test_image[ii]  = 30'h09249249;
    for (ii = 0; ii < WGT_ROWS; ii = ii + 1)
        test_weight[ii] = 15'h0249;

    spi_load_image();
    spi_load_weights();

    @(negedge TB_SYSTEM_CLOCK_50); #2; TB_SYSTEM_SS_N <= 1'b0;
    send_cmd(2'b10);
    @(negedge TB_SYSTEM_CLOCK_50); #2; TB_SYSTEM_MOSI <= 1'b0;
    @(posedge TB_SYSTEM_CLOCK_50); #1;
    @(negedge TB_SYSTEM_CLOCK_50); #2; TB_SYSTEM_MOSI <= 1'b0;
    @(posedge TB_SYSTEM_CLOCK_50); #1;
    @(negedge TB_SYSTEM_CLOCK_50); #2; TB_SYSTEM_SS_N <= 1'b1;

    $display("  Despues de CS up (start latched):");
    repeat(6) begin
        @(posedge TB_SYSTEM_CLOCK_50); #1;
        $display("    Ciclo: STATE=%0d", CNNver2_u0.cnn_ctrl_sm.STATE_Register);
    end

    if (CNNver2_u0.cnn_ctrl_sm.STATE_Register == 3'd0) begin
        $display("  >> TEST 9 PASSED (FSM retorno a IDLE)");
        pass_count = pass_count + 1;
    end else begin
        $display("  >> TEST 9 FAILED (FSM no retorno a IDLE)");
        fail_count = fail_count + 1;
    end

    // =========================================================
    // TEST 10: CNN ready flag y result register
    // =========================================================
    $display("");
    $display("--- TEST 10: CNN ready flag y result register ---");

    // ★E Wire names actualizados
    $display("  CNN ready = %b (esperado: 0 = en reset)",
        CNNver2_u0.CNN_ready_cwire);

    spi_start_cnn();

    $display("  Result register = %0d (signed)",
        $signed(CNNver2_u0.CNN_Result_out_cwire));

    if (CNNver2_u0.CNN_Result_out_cwire !== 11'bx) begin
        $display("  >> TEST 10 PASSED (resultado capturado)");
        pass_count = pass_count + 1;
    end else begin
        $display("  >> TEST 10 FAILED (resultado indefinido)");
        fail_count = fail_count + 1;
    end

    // =========================================================
    // TEST 11: Verificar image_mem interno del SPI slave
    // =========================================================
    $display("");
    $display("--- TEST 11: Verificar image_mem[0..9] en spi_cnn_slave_8 ---");

    for (ii = 0; ii < IMG_ROWS; ii = ii + 1)
        test_image[ii] = 30'h09249249 + ii;

    spi_load_image();

    $display("  imem[0]: %h (Exp: %h)",
        CNNver2_u0.spi_cnn_slave_8_u0.image_mem[0], test_image[0]);
    $display("  imem[4]: %h (Exp: %h)",
        CNNver2_u0.spi_cnn_slave_8_u0.image_mem[4], test_image[4]);
    $display("  imem[8]: %h (Exp: %h)",
        CNNver2_u0.spi_cnn_slave_8_u0.image_mem[8], test_image[8]);
    $display("  imem[9]: %h (Exp: %h)",
        CNNver2_u0.spi_cnn_slave_8_u0.image_mem[9], test_image[9]);

    if (CNNver2_u0.spi_cnn_slave_8_u0.image_mem[0] == test_image[0] &&
        CNNver2_u0.spi_cnn_slave_8_u0.image_mem[4] == test_image[4] &&
        CNNver2_u0.spi_cnn_slave_8_u0.image_mem[8] == test_image[8] &&
        CNNver2_u0.spi_cnn_slave_8_u0.image_mem[9] == test_image[9]) begin
        $display("  >> TEST 11 PASSED");
        pass_count = pass_count + 1;
    end else begin
        $display("  >> TEST 11 FAILED");
        fail_count = fail_count + 1;
    end

    // =========================================================
    // TEST 12: ★G Verificar weight_mem interno del SPI slave
    //   Reemplaza la verificacion anterior de 8 bytes
    //   Ahora: 5 slots de 15 bits
    // =========================================================
    $display("");
    $display("--- TEST 12: Verificar weight_mem[0..4] en spi_cnn_slave_8 ---");

    for (ii = 0; ii < WGT_ROWS; ii = ii + 1)
        test_weight[ii] = 15'h0249 + ii;  // valor unico por fila

    spi_load_weights();

    $display("  wmem[0]: %h (Exp: %h)",
        CNNver2_u0.spi_cnn_slave_8_u0.weight_mem[0], test_weight[0]);
    $display("  wmem[2]: %h (Exp: %h)",
        CNNver2_u0.spi_cnn_slave_8_u0.weight_mem[2], test_weight[2]);
    $display("  wmem[4]: %h (Exp: %h)",
        CNNver2_u0.spi_cnn_slave_8_u0.weight_mem[4], test_weight[4]);

    if (CNNver2_u0.spi_cnn_slave_8_u0.weight_mem[0] == test_weight[0] &&
        CNNver2_u0.spi_cnn_slave_8_u0.weight_mem[2] == test_weight[2] &&
        CNNver2_u0.spi_cnn_slave_8_u0.weight_mem[4] == test_weight[4]) begin
        $display("  >> TEST 12 PASSED");
        pass_count = pass_count + 1;
    end else begin
        $display("  >> TEST 12 FAILED");
        fail_count = fail_count + 1;
    end

    // =========================================================
    // RESUMEN FINAL
    // =========================================================
    $display("");
    $display("===================================================");
    $display("  RESULTADOS: %0d PASS  |  %0d FAIL", pass_count, fail_count);
    if (fail_count == 0)
        $display("  ALL TESTS PASSED");
    else
        $display("  SOME TESTS FAILED -- revisar ondas");
    $display("===================================================");

    #(TCK*5);
    $finish;
end

endmodule
