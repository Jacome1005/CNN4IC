`timescale 1 ns/ 1 ns
//=======================================================
//  TB_SYSTEM — Testbench completo: SPI + CNN integrado
//=======================================================
//  Protocolo SPI (2-bit cmd + data):
//    00 = LOAD IMAGE   (+ 8 bytes imagen por MOSI)
//    01 = LOAD WEIGHTS (+ 8 bytes pesos por MOSI)
//    10 = START CNN    (+ clocks dummy)
//    11 = READ RESULT  (+ clocks → MISO devuelve resultado)
//
//  Flujo completo de un cómputo CNN:
//    1. Transacción LOAD IMAGE  (CS↓ cmd00 + 64bits CS↑)
//    2. Transacción LOAD WEIGHTS(CS↓ cmd01 + 64bits CS↑)
//    3. Transacción START CNN   (CS↓ cmd10 + dummies CS↑)
//       -- Entre CS↑ y la siguiente transacción, la FSM
//          CNN_CTRL ejecuta: LOAD→PIPE1→PIPE2→CAPTURE
//    4. Transacción READ RESULT (CS↓ cmd11 + 11 clocks MISO)
//=======================================================

module TB_SYSTEM();

// ============================================
// Parameter
// ============================================
	reg eachvec;
	parameter TCK = 20; 
	parameter CLK_FREQ = 1000000000 / TCK;
	parameter DATAWIDTH_BUS = 8;
	
	integer ii = 0;
	integer jj = 0;
	integer pass_count = 0;
	integer fail_count = 0;

// ============================================
// INTERNAL WIRE AND REG DECLARATIONS
// ============================================
	wire TB_SYSTEM_MISO;
	reg TB_SYSTEM_CLOCK_50;
	reg TB_SYSTEM_SS_N;
	reg TB_SYSTEM_MOSI;
	reg [7:0] test_image  [0:7];
	reg [7:0] test_weight [0:7];
	reg [10:0] miso_captured;

// ============================================
// UNIT UNDER TEST INSTANTIATION
// ============================================
	CNNver2 #(
		.DATAWIDTH_BUS(DATAWIDTH_BUS)
	) CNNver2_u0 (
		.CNNver2_SPICLOCK_50(TB_SYSTEM_CLOCK_50),
		.CNNver2_SS_N       (TB_SYSTEM_SS_N),
		.CNNver2_MOSI       (TB_SYSTEM_MOSI),
		.CNNver2_MISO       (TB_SYSTEM_MISO)
	);

// ============================================
// INITIAL BLOCK: Setup
// ============================================
initial                                                 
begin                                                   
	TB_SYSTEM_CLOCK_50 <= 0;
	TB_SYSTEM_SS_N     <= 1'b1;
	TB_SYSTEM_MOSI     <= 1'b0;
end                                                     

// ============================================
// CLOCK GENERATION — 50 MHz (periodo 20 ns)
// ============================================
always                                                  
	#(TCK/2) TB_SYSTEM_CLOCK_50 <= ~ TB_SYSTEM_CLOCK_50;

// ============================================
// TASK: Send SPI Byte (MSB First) con Retrasos
// ============================================
task send_byte;
	input [7:0] byte_in;
	begin
		for (jj = 7; jj >= 0; jj = jj - 1) begin
			@(negedge TB_SYSTEM_CLOCK_50);
			#2;
			TB_SYSTEM_MOSI = byte_in[jj];
			@(posedge TB_SYSTEM_CLOCK_50);
			#1;
		end
	end
endtask

// ============================================
// TASK: Send SPI Command (2 bits, MSB first)
// ============================================
task send_cmd;
	input [1:0] cmd_in;
	begin
		// Bit 1 (MSB)
		@(negedge TB_SYSTEM_CLOCK_50); #2; TB_SYSTEM_MOSI <= cmd_in[1];
		@(posedge TB_SYSTEM_CLOCK_50); #1;
		// Bit 0 (LSB)
		@(negedge TB_SYSTEM_CLOCK_50); #2; TB_SYSTEM_MOSI <= cmd_in[0];
		@(posedge TB_SYSTEM_CLOCK_50); #1;
	end
endtask

// ============================================
// TASK: SPI Transaction — LOAD IMAGE (cmd 00)
// ============================================
task spi_load_image;
	begin
		// CS low
		@(negedge TB_SYSTEM_CLOCK_50); #2;
		TB_SYSTEM_SS_N <= 1'b0;
		// Command
		send_cmd(2'b00);
		// 8 bytes
		for (ii = 0; ii < 8; ii = ii + 1) begin
			send_byte(test_image[ii]);
		end
		// CS high
		#(TCK);
		@(negedge TB_SYSTEM_CLOCK_50); #2;
		TB_SYSTEM_SS_N <= 1'b1;
		#(TCK*5);
	end
endtask

// ============================================
// TASK: SPI Transaction — LOAD WEIGHTS (cmd 01)
// ============================================
task spi_load_weights;
	begin
		@(negedge TB_SYSTEM_CLOCK_50); #2;
		TB_SYSTEM_SS_N <= 1'b0;
		send_cmd(2'b01);
		for (ii = 0; ii < 8; ii = ii + 1) begin
			send_byte(test_weight[ii]);
		end
		#(TCK);
		@(negedge TB_SYSTEM_CLOCK_50); #2;
		TB_SYSTEM_SS_N <= 1'b1;
		#(TCK*5);
	end
endtask

// ============================================
// TASK: SPI Transaction — START CNN (cmd 10)
//   Envía 2 bits cmd + 4 bits dummy para que
//   o_start_cnn se active dentro del SPI.
//   Luego CS sube y la FSM CNN_CTRL procesa.
// ============================================
task spi_start_cnn;
	begin
		@(negedge TB_SYSTEM_CLOCK_50); #2;
		TB_SYSTEM_SS_N <= 1'b0;
		send_cmd(2'b10);
		// Clocks dummy (mantener CS bajo para que o_start_cnn=1)
		for (ii = 0; ii < 4; ii = ii + 1) begin
			@(negedge TB_SYSTEM_CLOCK_50); #2;
			TB_SYSTEM_MOSI <= 1'b0;
			@(posedge TB_SYSTEM_CLOCK_50); #1;
		end
		// CS alto — dispara CNN_CTRL (start_latch ya capturado)
		@(negedge TB_SYSTEM_CLOCK_50); #2;
		TB_SYSTEM_SS_N <= 1'b1;
		// Esperar que FSM CNN_CTRL complete:
		// IDLE(ya)→LOAD→PIPE1→PIPE2→CAPTURE→IDLE = ~5-6 ciclos
		#(TCK*10);
	end
endtask

// ============================================
// TASK: SPI Transaction — READ RESULT (cmd 11)
//   Envía 2 bits cmd, luego 11 clocks para
//   recibir resultado CNN por MISO.
//   NOTA: El primer clock MISO = Z (miso_active
//   tarda 1 ciclo). Bits efectivos comienzan
//   en el 2do clock: result[9], [8], ..., [0].
// ============================================
task spi_read_result;
	begin
		miso_captured = 11'd0;
		@(negedge TB_SYSTEM_CLOCK_50); #2;
		TB_SYSTEM_SS_N <= 1'b0;
		send_cmd(2'b11);
		// 1er clock dummy (MISO aún Z)
		@(negedge TB_SYSTEM_CLOCK_50); #2;
		TB_SYSTEM_MOSI <= 1'b0;
		@(posedge TB_SYSTEM_CLOCK_50); #1;
		// 10 clocks para capturar bits [9:0]
		for (ii = 9; ii >= 0; ii = ii - 1) begin
			@(negedge TB_SYSTEM_CLOCK_50); #2;
			TB_SYSTEM_MOSI <= 1'b0;
			@(posedge TB_SYSTEM_CLOCK_50); #1;
			// Capturar MISO después del posedge (dato estable)
			#2;
			miso_captured[ii] = TB_SYSTEM_MISO;
		end
		@(negedge TB_SYSTEM_CLOCK_50); #2;
		TB_SYSTEM_SS_N <= 1'b1;
		#(TCK*5);
	end
endtask

// ============================================
// TASK: Computa resultado CNN esperado
//   Replica la lógica de cnn_v2 en software:
//   pack 8 bytes → 75-bit flat → 25 × 3-bit
//   multiply-accumulate.
// ============================================
reg signed [10:0] expected_y;

task compute_expected;
	reg [74:0] px_flat;
	reg [74:0] w_flat;
	reg signed [2:0] px_k;
	reg signed [2:0] w_k;
	reg signed [10:0] acc;
	integer k;
	begin
		px_flat = {11'b0,
			test_image[7], test_image[6], test_image[5], test_image[4],
			test_image[3], test_image[2], test_image[1], test_image[0]};
		w_flat = {11'b0,
			test_weight[7], test_weight[6], test_weight[5], test_weight[4],
			test_weight[3], test_weight[2], test_weight[1], test_weight[0]};
		acc = 11'sd0;
		for (k = 0; k < 25; k = k + 1) begin
			px_k = px_flat[k*3 +: 3];
			w_k  = w_flat[k*3 +: 3];
			acc  = acc + ($signed(px_k) * w_k);
		end
		expected_y = acc;
	end
endtask

// ============================================
// TASK: check_result — compara y reporta
// ============================================
task check_result;
	input [79:0] test_name; // hasta 10 chars
	begin
		compute_expected;
		$display("  CNN y_out   = %0d (signed)", $signed(CNNver2_u0.CNN_y_out_routing_cwire));
		$display("  Result Reg  = %0d (signed)", $signed(CNNver2_u0.CNN_Result_DataOutBUS_routing_cwire));
		$display("  Expected    = %0d", expected_y);
		$display("  MISO[9:0]   = %0d (signed)", $signed(miso_captured[9:0]));
		if ($signed(CNNver2_u0.CNN_Result_DataOutBUS_routing_cwire) === expected_y) begin
			$display("  >> PASS");
			pass_count = pass_count + 1;
		end else begin
			$display("  >> FAIL (got %0d, expected %0d)",
				$signed(CNNver2_u0.CNN_Result_DataOutBUS_routing_cwire), expected_y);
			fail_count = fail_count + 1;
		end
	end
endtask

// ============================================
// STIMULUS PROCESS
// ============================================
initial begin
	$display("===================================================");
	$display("  TB CNNver2 — SPI + CNN Integration Testbench");
	$display("===================================================");
	$display("  Mapeo: 8 bytes → {11'b0, b7..b0} = 75 bits");
	$display("  25 × 3-bit signed: pos[0..20] datos, [21] parcial, [22..24] cero");
	$display("  Pipeline CNN: 2 ciclos (captura + computo)");
	$display("===================================================");

	#(TCK*10);

	// Reset rápido para limpiar registros
	force CNNver2_u0.CNNver2_Reset_InHigh = 1'b1;
	#40;
	force CNNver2_u0.CNNver2_Reset_InHigh = 1'b0;
	#(TCK*3);

	// =========================================================
	// TEST 1: SPI Image Load — compatibilidad con test original
	// =========================================================
	$display("");
	$display("--- TEST 1: SPI LOAD IMAGE (compatibilidad) ---");

	test_image[0] = 8'hAA; test_image[1] = 8'hBB;
	test_image[2] = 8'hCC; test_image[3] = 8'hDD;
	test_image[4] = 8'hEE; test_image[5] = 8'hFF;
	test_image[6] = 8'h11; test_image[7] = 8'h22;

	spi_load_image();

	$display("VERIFICACION DE REGISTROS (Hardware Output):");
	$display("Reg0: %h (Exp: AA) | Reg1: %h (Exp: BB)",
		CNNver2_u0.register_u0.Register_DataOutBUS,
		CNNver2_u0.register_u1.Register_DataOutBUS);
	$display("Reg2: %h (Exp: CC) | Reg3: %h (Exp: DD)",
		CNNver2_u0.register_u2.Register_DataOutBUS,
		CNNver2_u0.register_u3.Register_DataOutBUS);
	$display("Reg4: %h (Exp: EE) | Reg5: %h (Exp: FF)",
		CNNver2_u0.register_u4.Register_DataOutBUS,
		CNNver2_u0.register_u5.Register_DataOutBUS);
	$display("Reg6: %h (Exp: 11) | Reg7: %h (Exp: 22)",
		CNNver2_u0.register_u6.Register_DataOutBUS,
		CNNver2_u0.register_u7.Register_DataOutBUS);
	$display("---------------------------------------------------");

	if (CNNver2_u0.register_u0.Register_DataOutBUS == 8'hAA &&
	    CNNver2_u0.register_u1.Register_DataOutBUS == 8'hBB &&
	    CNNver2_u0.register_u6.Register_DataOutBUS == 8'h11 &&
	    CNNver2_u0.register_u7.Register_DataOutBUS == 8'h22) begin
		$display("  >> TEST 1 PASSED");
		pass_count = pass_count + 1;
	end else begin
		$display("  >> TEST 1 FAILED");
		fail_count = fail_count + 1;
	end

	// =========================================================
	// TEST 2: SPI Weight Load — verificar weight_mem
	// =========================================================
	$display("");
	$display("--- TEST 2: SPI LOAD WEIGHTS ---");

	test_weight[0] = 8'hA1; test_weight[1] = 8'hB2;
	test_weight[2] = 8'hC3; test_weight[3] = 8'hD4;
	test_weight[4] = 8'hE5; test_weight[5] = 8'hF6;
	test_weight[6] = 8'h17; test_weight[7] = 8'h28;

	spi_load_weights();

	$display("VERIFICACION weight_mem interno del SPI:");
	$display("  wmem[0]: %h (Exp: A1) | wmem[1]: %h (Exp: B2)",
		CNNver2_u0.spi_cnn_slave_8_u0.weight_mem[0],
		CNNver2_u0.spi_cnn_slave_8_u0.weight_mem[1]);
	$display("  wmem[6]: %h (Exp: 17) | wmem[7]: %h (Exp: 28)",
		CNNver2_u0.spi_cnn_slave_8_u0.weight_mem[6],
		CNNver2_u0.spi_cnn_slave_8_u0.weight_mem[7]);

	if (CNNver2_u0.spi_cnn_slave_8_u0.weight_mem[0] == 8'hA1 &&
	    CNNver2_u0.spi_cnn_slave_8_u0.weight_mem[7] == 8'h28) begin
		$display("  >> TEST 2 PASSED");
		pass_count = pass_count + 1;
	end else begin
		$display("  >> TEST 2 FAILED");
		fail_count = fail_count + 1;
	end

	// =========================================================
	// TEST 3: CNN — Todo ceros
	//   Imagen=0x00×8, Pesos=0x00×8 → CNN=0
	// =========================================================
	$display("");
	$display("--- TEST 3: CNN flujo completo — Todo Ceros ---");

	for (ii = 0; ii < 8; ii = ii + 1) begin
		test_image[ii]  = 8'h00;
		test_weight[ii] = 8'h00;
	end

	spi_load_image();
	spi_load_weights();
	spi_start_cnn();
	spi_read_result();

	check_result("ZEROS");

	// =========================================================
	// TEST 4: CNN — Todo 0xFF
	//   Cada grupo 3-bit en datos (pos 0..20) = 111 = -1 signed
	//   Grupo 21 = {0, 0, bit63=1} = 001 = +1
	//   Grupos 22..24 = 000 = 0
	//   Products: 21×(-1)(-1) + 1×(1)(1) + 0+0+0 = 21+1 = 22
	// =========================================================
	$display("");
	$display("--- TEST 4: CNN flujo completo — Todo 0xFF ---");

	for (ii = 0; ii < 8; ii = ii + 1) begin
		test_image[ii]  = 8'hFF;
		test_weight[ii] = 8'hFF;
	end

	spi_load_image();
	spi_load_weights();
	spi_start_cnn();
	spi_read_result();

	check_result("ALL_FF");

	// =========================================================
	// TEST 5: CNN — Positivos uniformes
	//   Bytes elegidos para que 3-bit groups = 001 (+1):
	//   0x49=01001001, 0x24=00100100, 0x92=10010010
	//   Patrón cíclico 001 en los 64 bits de datos.
	//   Posiciones 0..20: px=+1, w=+1 → prod=1, sum=21
	//   Posición 21: {0,0,byte7[7]} depende del byte7
	//   Posiciones 22..24: 0
	// =========================================================
	$display("");
	$display("--- TEST 5: CNN — patron 001 uniforme ---");

	test_image[0] = 8'h49; test_image[1] = 8'h92;
	test_image[2] = 8'h24; test_image[3] = 8'h49;
	test_image[4] = 8'h92; test_image[5] = 8'h24;
	test_image[6] = 8'h49; test_image[7] = 8'h12;

	test_weight[0] = 8'h49; test_weight[1] = 8'h92;
	test_weight[2] = 8'h24; test_weight[3] = 8'h49;
	test_weight[4] = 8'h92; test_weight[5] = 8'h24;
	test_weight[6] = 8'h49; test_weight[7] = 8'h12;

	spi_load_image();
	spi_load_weights();
	spi_start_cnn();
	spi_read_result();

	check_result("UNI_001");

	// =========================================================
	// TEST 6: CNN — Peso negativo, imagen positiva
	//   Imagen: bytes para px = +1 (patrón 001)
	//   Pesos:  bytes para w  = -1 (patrón 111 = 0xFF)
	//   Posiciones 0..20: px=+1, w=-1 → prod=-1, sum=-21
	//   Posición 21: depende de los bytes
	// =========================================================
	$display("");
	$display("--- TEST 6: CNN — imagen positiva, peso negativo ---");

	test_image[0] = 8'h49; test_image[1] = 8'h92;
	test_image[2] = 8'h24; test_image[3] = 8'h49;
	test_image[4] = 8'h92; test_image[5] = 8'h24;
	test_image[6] = 8'h49; test_image[7] = 8'h12;

	for (ii = 0; ii < 8; ii = ii + 1)
		test_weight[ii] = 8'hFF;

	spi_load_image();
	spi_load_weights();
	spi_start_cnn();
	spi_read_result();

	check_result("POS_NEG");

	// =========================================================
	// TEST 7: CNN — Patrón mixto arbitrario
	//   Valores variados para cubrir edge cases de multiplicación
	// =========================================================
	$display("");
	$display("--- TEST 7: CNN — patron mixto arbitrario ---");

	test_image[0]  = 8'hA5; test_image[1]  = 8'h3C;
	test_image[2]  = 8'h69; test_image[3]  = 8'hFF;
	test_image[4]  = 8'h00; test_image[5]  = 8'h55;
	test_image[6]  = 8'hAA; test_image[7]  = 8'h01;

	test_weight[0] = 8'h5A; test_weight[1] = 8'hC3;
	test_weight[2] = 8'h96; test_weight[3] = 8'h00;
	test_weight[4] = 8'hFF; test_weight[5] = 8'hAA;
	test_weight[6] = 8'h55; test_weight[7] = 8'h80;

	spi_load_image();
	spi_load_weights();
	spi_start_cnn();
	spi_read_result();

	check_result("MIXED");

	// =========================================================
	// TEST 8: Verificar registros de pesos después de START
	//   Los weight_register_uN deben tener los valores que
	//   estaban en weight_mem cuando START CNN fue ejecutado.
	// =========================================================
	$display("");
	$display("--- TEST 8: Verificar weight registers post-CNN ---");

	$display("  WReg0: %h (Exp: 5A)", CNNver2_u0.weight_register_u0.Register_DataOutBUS);
	$display("  WReg3: %h (Exp: 00)", CNNver2_u0.weight_register_u3.Register_DataOutBUS);
	$display("  WReg7: %h (Exp: 80)", CNNver2_u0.weight_register_u7.Register_DataOutBUS);

	if (CNNver2_u0.weight_register_u0.Register_DataOutBUS == 8'h5A &&
	    CNNver2_u0.weight_register_u3.Register_DataOutBUS == 8'h00 &&
	    CNNver2_u0.weight_register_u7.Register_DataOutBUS == 8'h80) begin
		$display("  >> TEST 8 PASSED");
		pass_count = pass_count + 1;
	end else begin
		$display("  >> TEST 8 FAILED");
		fail_count = fail_count + 1;
	end

	// =========================================================
	// TEST 9: Verificar estados FSM CNN_CTRL
	//   Ejecutar otra operación y monitorear STATE_Register
	// =========================================================
	$display("");
	$display("--- TEST 9: FSM CNN Controller states ---");
	$display("  Estado actual: %0d (esperado: 0=IDLE)",
		CNNver2_u0.cnn_ctrl_sm.STATE_Register);

	for (ii = 0; ii < 8; ii = ii + 1) begin
		test_image[ii]  = 8'h49;
		test_weight[ii] = 8'h49;
	end
	spi_load_image();
	spi_load_weights();

	// START pero observar la FSM entre ciclos
	@(negedge TB_SYSTEM_CLOCK_50); #2;
	TB_SYSTEM_SS_N <= 1'b0;
	send_cmd(2'b10);
	// Dummy clocks
	@(negedge TB_SYSTEM_CLOCK_50); #2; TB_SYSTEM_MOSI <= 1'b0;
	@(posedge TB_SYSTEM_CLOCK_50); #1;
	@(negedge TB_SYSTEM_CLOCK_50); #2; TB_SYSTEM_MOSI <= 1'b0;
	@(posedge TB_SYSTEM_CLOCK_50); #1;
	// CS high
	@(negedge TB_SYSTEM_CLOCK_50); #2;
	TB_SYSTEM_SS_N <= 1'b1;

	// Observar transiciones de FSM
	$display("  Después de CS↑ (start latched):");
	@(posedge TB_SYSTEM_CLOCK_50); #1;
	$display("    Ciclo 1: STATE=%0d (start_latch=%b)",
		CNNver2_u0.cnn_ctrl_sm.STATE_Register,
		CNNver2_u0.cnn_ctrl_sm.start_latch);
	@(posedge TB_SYSTEM_CLOCK_50); #1;
	$display("    Ciclo 2: STATE=%0d",
		CNNver2_u0.cnn_ctrl_sm.STATE_Register);
	@(posedge TB_SYSTEM_CLOCK_50); #1;
	$display("    Ciclo 3: STATE=%0d",
		CNNver2_u0.cnn_ctrl_sm.STATE_Register);
	@(posedge TB_SYSTEM_CLOCK_50); #1;
	$display("    Ciclo 4: STATE=%0d",
		CNNver2_u0.cnn_ctrl_sm.STATE_Register);
	@(posedge TB_SYSTEM_CLOCK_50); #1;
	$display("    Ciclo 5: STATE=%0d",
		CNNver2_u0.cnn_ctrl_sm.STATE_Register);
	@(posedge TB_SYSTEM_CLOCK_50); #1;
	$display("    Ciclo 6: STATE=%0d (esperado: 0=IDLE)",
		CNNver2_u0.cnn_ctrl_sm.STATE_Register);

	if (CNNver2_u0.cnn_ctrl_sm.STATE_Register == 3'd0) begin
		$display("  >> TEST 9 PASSED (FSM retornó a IDLE)");
		pass_count = pass_count + 1;
	end else begin
		$display("  >> TEST 9 FAILED (FSM no retornó a IDLE)");
		fail_count = fail_count + 1;
	end

	// =========================================================
	// TEST 10: CNN ready flag
	// =========================================================
	$display("");
	$display("--- TEST 10: CNN ready flag ---");
	$display("  CNN ready = %b (CNN en reset → esperado: 0)",
		CNNver2_u0.CNN_ready_routing_cwire);

	// Disparar CNN y esperar ready
	spi_start_cnn();
	// Nota: después de spi_start_cnn y los waits, la FSM ya pasó por CAPTURE
	// CNN está de vuelta en reset, así que ready = 0 otra vez.
	// Pero result_register conserva el resultado.

	$display("  Result register = %0d",
		$signed(CNNver2_u0.CNN_Result_DataOutBUS_routing_cwire));

	if (CNNver2_u0.CNN_Result_DataOutBUS_routing_cwire !== 11'bx) begin
		$display("  >> TEST 10 PASSED (resultado capturado)");
		pass_count = pass_count + 1;
	end else begin
		$display("  >> TEST 10 FAILED (resultado indefinido)");
		fail_count = fail_count + 1;
	end

	// =========================================================
	// RESUMEN FINAL
	// =========================================================
	$display("");
	$display("===================================================");
	$display("  RESULTADOS: %0d PASS  |  %0d FAIL", pass_count, fail_count);
	if (fail_count == 0)
		$display("  ALL TESTS PASSED");
	else
		$display("  SOME TESTS FAILED — revisar ondas");
	$display("===================================================");

	#(TCK*5);
	$finish;                                              
end                                                     

endmodule
