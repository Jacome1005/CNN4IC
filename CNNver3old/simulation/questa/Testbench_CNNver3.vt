`timescale 1 ns/ 1 ns
//=======================================================
//  TB_CNNver3 — Testbench completo para CNNver3
//=======================================================
//  Protocolo SPI (3-bit cmd en MOSI, MSB first):
//    3'b000 = IDLE
//    3'b001 = LOAD IMAGE   (10 filas × 30 bits)
//    3'b010 = LOAD WEIGHTS ( 5 filas × 15 bits)
//    3'b011 = START CNN    (sin payload, dispara o_start_cnn en bit_count==3)
//    3'b100 = READ RESULT  (1 clock → MISO bit comparador)
//    3'b101 = READ MR1     (16 clocks → MISO acc0 MSB first)
//    3'b110 = READ MR2     (16 clocks → MISO acc1 MSB first)
//    3'b111 = READ WEIGHTS (16 clocks → MISO)
//
//  Diferencias respecto a CNNver2:
//    - CNNver3_CMD_Reset eliminado (el reset de transacción lo hace SS_N)
//    - Dos kernels procesados de forma secuencial (dos STARTs)
//    - MR1 = acc kernel0, MR2 = acc kernel1
//    - READ MR1 = cmd 101 (16 bits), READ MR2 = cmd 110 (16 bits)
//    - READ RESULT = cmd 100 (1 bit comparador MR1>MR2)
//    - No hay LOAD MAXPOOL, SAVE ACCUM ni accum_maxpool
//
//  Tests:
//    1  — SPI Load Image  (10 × 30b) — verifica image_mem y registros
//    2  — SPI Load Weights (5 × 15b) — verifica weight_mem y registros
//    3  — CNN ceros (imagen=0, pesos=0) → MR1=0, MR2=0, comp=0
//    4  — CNN -1/-1  (imagen=-1, pesos=-1) → acc=+25, MR1=MR2=+25, comp=0
//    5  — CNN +1/+1  (imagen=+1, pesos=+1) → acc=+25, comp=0
//    6  — CNN +1/-1  (imagen=+1, pesos=-1) → acc=-25, comp según MR1/MR2
//    7  — CNN patron mixto arbitrario (compute_expected)
//    8  — Weight registers post-CNN intactos
//    9  — FSM CNN Controller: verificar retorno a IDLE tras ciclo completo
//   10  — Flujo doble kernel: K0=+1/+1→MR1=+225, K1=-1/-1→MR2=-225
//   11  — image_mem interno SPI con patron incremental
//   12  — weight_mem interno SPI con patron incremental
//   13  — READ MR1 via MISO (cmd 101, 16 bits)
//   14  — READ MR2 via MISO (cmd 110, 16 bits)
//   15  — READ RESULT via MISO (cmd 100, 1 bit comparador)
//   16  — SS_N sube a mitad de fila: datos NO se guardan (reemplaza cmd_reset)
//   17  — Comparador: MR1 > MR2 → comp=1
//   18  — Comparador: MR1 < MR2 → comp=0
//   19  — Comparador: MR1 = MR2 → comp=0
//   20  — FSM WAIT_K1: segundo START llega correctamente
//=======================================================

module TB_CNNver3();

// ============================================================
//  PARAMETROS
// ============================================================
parameter TCK = 20;      // periodo de reloj SPI en ns

parameter IMG_ROWS     = 10;
parameter IMG_COLS     = 10;
parameter BITS_PER_POS = 3;
parameter ROW_BITS     = IMG_COLS * BITS_PER_POS;       // 30
parameter IMG_TOTAL_BITS = IMG_ROWS * ROW_BITS;          // 300

parameter KERN_SIZE      = 5;
parameter WGT_ROWS       = KERN_SIZE;                   // 5
parameter WGT_ROW_BITS   = KERN_SIZE * BITS_PER_POS;   // 15
parameter WGT_TOTAL_BITS = WGT_ROWS * WGT_ROW_BITS;    // 75

// Número de ciclos a esperar que cnn_top complete (9 frags × ~12 ciclos)
// Se usa en spi_wait_cnn y espera de MRx_load.
parameter CNN_TIMEOUT    = 5000;

integer ii;
integer jj;
integer pass_count;
integer fail_count;

initial begin
    pass_count = 0;
    fail_count = 0;
    ii = 0;
    jj = 0;
end

// ============================================================
//  DECLARACIONES
// ============================================================
wire        TB_MISO;
reg         TB_CLK;
reg         TB_SS_N;
reg         TB_MOSI;
reg         TB_RESET;

reg [ROW_BITS-1:0]     test_image  [0:IMG_ROWS-1];
reg [WGT_ROW_BITS-1:0] test_weight [0:WGT_ROWS-1];
reg signed [15:0]      miso_mr1;       // resultado READ MR1  (16 bits)
reg signed [15:0]      miso_mr2;       // resultado READ MR2  (16 bits)
reg                    comp_captured;  // resultado READ RESULT (1 bit)

// ============================================================
//  INSTANCIA UUT — CNNver3 (7 puertos: sin CMD_Reset)
// ============================================================
CNNver3 CNNver3_u0 (
    .CNNver3_SPICLOCK_50  (TB_CLK),
    .CNNver3_SS_N         (TB_SS_N),
    .CNNver3_MOSI         (TB_MOSI),
    .CNNver3_MISO         (TB_MISO),
    .CNNver3_Reset_InHigh (TB_RESET),
    .CNNver3_MR1_Load     (),    // observado internamente vía jerarquía
    .CNNver3_MR2_Load     ()
);

// ============================================================
//  INICIALIZACION Y CLOCK
// ============================================================
initial begin
    TB_CLK   <= 1'b0;
    TB_SS_N  <= 1'b1;
    TB_MOSI  <= 1'b0;
    TB_RESET <= 1'b0;
end

always #(TCK/2) TB_CLK <= ~TB_CLK;

// ============================================================
//  TASKS SPI BASE
// ============================================================

// send_cmd: 3 bits MSB primero, cambia en negedge, muestrea en posedge
task send_cmd;
    input [2:0] cmd_in;
    begin
        @(negedge TB_CLK); #2; TB_MOSI <= cmd_in[2];
        @(posedge TB_CLK); #1;
        @(negedge TB_CLK); #2; TB_MOSI <= cmd_in[1];
        @(posedge TB_CLK); #1;
        @(negedge TB_CLK); #2; TB_MOSI <= cmd_in[0];
        @(posedge TB_CLK); #1;
    end
endtask

// send_row: ROW_BITS bits MSB primero
task send_row;
    input [ROW_BITS-1:0] row_in;
    begin
        for (jj = ROW_BITS-1; jj >= 0; jj = jj - 1) begin
            @(negedge TB_CLK); #2; TB_MOSI = row_in[jj];
            @(posedge TB_CLK); #1;
        end
    end
endtask

// send_weight_row: WGT_ROW_BITS bits MSB primero
task send_weight_row;
    input [WGT_ROW_BITS-1:0] wrow_in;
    begin
        for (jj = WGT_ROW_BITS-1; jj >= 0; jj = jj - 1) begin
            @(negedge TB_CLK); #2; TB_MOSI = wrow_in[jj];
            @(posedge TB_CLK); #1;
        end
    end
endtask

// ============================================================
//  TASKS SPI: LOAD IMAGE  (cmd 001)
// ============================================================
task spi_load_image;
    begin
        @(negedge TB_CLK); #2; TB_SS_N <= 1'b0;
        send_cmd(3'b001);
        for (ii = 0; ii < IMG_ROWS; ii = ii + 1)
            send_row(test_image[ii]);
        @(negedge TB_CLK); #2; TB_SS_N <= 1'b1;
        #(TCK*5);
    end
endtask

// ============================================================
//  TASKS SPI: LOAD WEIGHTS  (cmd 010)
// ============================================================
task spi_load_weights;
    begin
        @(negedge TB_CLK); #2; TB_SS_N <= 1'b0;
        send_cmd(3'b010);
        for (ii = 0; ii < WGT_ROWS; ii = ii + 1)
            send_weight_row(test_weight[ii]);
        @(negedge TB_CLK); #2; TB_SS_N <= 1'b1;
        #(TCK*5);
    end
endtask

// ============================================================
//  TASKS SPI: START CNN  (cmd 011)
//  Protocolo: 3 bits cmd + 1 dummy clock (bit_count==3 dispara o_start_cnn)
//  SS_N sube después del dummy clock.
// ============================================================
task spi_start_cnn;
    begin
        @(negedge TB_CLK); #2; TB_SS_N <= 1'b0;
        send_cmd(3'b011);
        // dummy clock: bit_count==3 con cmd==011 → o_start_cnn pulsa
        @(negedge TB_CLK); #2; TB_MOSI <= 1'b0;
        @(posedge TB_CLK); #1;
        @(negedge TB_CLK); #2; TB_SS_N <= 1'b1;
        #(TCK*5);
    end
endtask

// ============================================================
//  TASKS: esperar MR1_Load bajo (fin kernel0)
// ============================================================
task esperar_mr1_load;
    integer n;
    begin
        n = 0;
        while (CNNver3_u0.CNN_CTRL_mr1_load_cwire === 1'b1 && n < CNN_TIMEOUT) begin
            @(posedge TB_CLK); n = n + 1;
        end
        if (n >= CNN_TIMEOUT)
            $display("  [TIMEOUT] mr1_load nunca se activó");
        else
            $display("  mr1_load bajo en ciclo %0d", n);
        @(posedge TB_CLK); // esperar que la FSM registre acc0→MR1
        #(TCK*3);
    end
endtask

// ============================================================
//  TASKS: esperar MR2_Load bajo (fin kernel1)
// ============================================================
task esperar_mr2_load;
    integer n;
    begin
        n = 0;
        while (CNNver3_u0.CNN_CTRL_mr2_load_cwire === 1'b1 && n < CNN_TIMEOUT) begin
            @(posedge TB_CLK); n = n + 1;
        end
        if (n >= CNN_TIMEOUT)
            $display("  [TIMEOUT] mr2_load nunca se activó");
        else
            $display("  mr2_load bajo en ciclo %0d", n);
        @(posedge TB_CLK);
        #(TCK*3);
    end
endtask

// ============================================================
//  TASKS SPI: READ MR1 — cmd 101, 16 bits MSB first via MISO
// ============================================================
task spi_read_mr1;
    begin
        miso_mr1 = 16'sd0;
        @(negedge TB_CLK); #2; TB_SS_N <= 1'b0;
        send_cmd(3'b101);
        // 16 clocks: miso_count avanza de 0 a 15
        for (ii = 15; ii >= 0; ii = ii - 1) begin
            @(negedge TB_CLK); #2; TB_MOSI <= 1'b0;
            @(posedge TB_CLK); #1; #2;
            miso_mr1[ii] = TB_MISO;
        end
        @(negedge TB_CLK); #2; TB_SS_N <= 1'b1;
        #(TCK*5);
    end
endtask

// ============================================================
//  TASKS SPI: READ MR2 — cmd 110, 16 bits MSB first via MISO
// ============================================================
task spi_read_mr2;
    begin
        miso_mr2 = 16'sd0;
        @(negedge TB_CLK); #2; TB_SS_N <= 1'b0;
        send_cmd(3'b110);
        for (ii = 15; ii >= 0; ii = ii - 1) begin
            @(negedge TB_CLK); #2; TB_MOSI <= 1'b0;
            @(posedge TB_CLK); #1; #2;
            miso_mr2[ii] = TB_MISO;
        end
        @(negedge TB_CLK); #2; TB_SS_N <= 1'b1;
        #(TCK*5);
    end
endtask

// ============================================================
//  TASKS SPI: READ RESULT — cmd 100, 1 bit comparador via MISO
// ============================================================
task spi_read_compare;
    begin
        comp_captured = 1'b0;
        @(negedge TB_CLK); #2; TB_SS_N <= 1'b0;
        send_cmd(3'b100);
        // 1 clock: miso_active=1, MISO = i_comp_result
        @(negedge TB_CLK); #2; TB_MOSI <= 1'b0;
        @(posedge TB_CLK); #1; #2;
        comp_captured = TB_MISO;
        @(negedge TB_CLK); #2; TB_SS_N <= 1'b1;
        #(TCK*5);
    end
endtask

// ============================================================
//  TASK: spi_run_full_dual_kernel
//  Flujo completo: carga imagen + kernel0 → START → espera MR1
//                  luego carga kernel1 → START → espera MR2
//  test_image, test_weight deben estar cargados ANTES de llamar.
//  El segundo kernel se toma de test_weight también (el llamador
//  lo actualiza entre los dos spi_load_weights).
// ============================================================
task spi_run_kernel0;
    // Precondición: test_image y test_weight (kernel0) ya cargados
    begin
        spi_load_image();
        spi_load_weights();
        spi_start_cnn();
        esperar_mr1_load();
    end
endtask

task spi_run_kernel1;
    // Precondición: test_weight (kernel1) actualizado
    begin
        spi_load_weights();
        spi_start_cnn();
        esperar_mr2_load();
    end
endtask

// ============================================================
//  TASK: compute_expected
//  Calcula convolucion 5x5 en la ventana (R_OFF=0, C_OFF=0)
//  del fragmento 0 de la imagen 10x10.
//  Esta es la misma ventana que MAC procesa en el primer frag.
//  NOTA: cnn_top acumula maxpool de 9 fragmentos. Para patrones
//  uniformes (todos iguales) el resultado es 9 × conv_ventana.
// ============================================================
reg signed [10:0] expected_one_window;  // conv de una ventana 5x5
reg signed [15:0] expected_acc;         // acum de 9 maxpools (uniforme)

task compute_expected_uniform;
    // Asume imagen y pesos uniformes (todos la misma celda 3b)
    // Solo calcula la convolución de la primera ventana 5x5
    reg [IMG_TOTAL_BITS-1:0] px_flat;
    reg [WGT_TOTAL_BITS-1:0] w_flat;
    reg signed [2:0] px_k;
    reg signed [2:0] w_k;
    reg signed [10:0] acc_window;
    integer k, bit_off_px;
    begin
        px_flat = {
            test_image[9], test_image[8], test_image[7], test_image[6], test_image[5],
            test_image[4], test_image[3], test_image[2], test_image[1], test_image[0]
        };
        w_flat = {
            test_weight[4], test_weight[3], test_weight[2], test_weight[1], test_weight[0]
        };
        acc_window = 11'sd0;
        for (k = 0; k < 25; k = k + 1) begin
            bit_off_px = (k/5)*30 + (k%5)*3;
            px_k = $signed(px_flat[bit_off_px +: 3]);
            w_k  = $signed(w_flat[k*3 +: 3]);
            acc_window = acc_window + (px_k * w_k);
        end
        expected_one_window = acc_window;
        // Para imagen uniforme, maxpool de cada fragmento = misma conv
        // y acc = 9 * maxpool
        expected_acc = $signed({{5{acc_window[10]}}, acc_window}) * 16'sd9;
    end
endtask

// ============================================================
//  STIMULUS
// ============================================================
initial begin
    $display("===================================================");
    $display("  TB CNNver3 — Testbench completo");
    $display("  Puertos top: MISO,MOSI,CLK,SS_N,RESET,MR1_Load,MR2_Load");
    $display("  CMD_Reset ELIMINADO: reset de transacción vía SS_N");
    $display("  Comandos: 001-LOAD_IMG  010-LOAD_WGT  011-START_CNN");
    $display("            100-READ_CMP  101-READ_MR1   110-READ_MR2");
    $display("            111-READ_WGT");
    $display("===================================================");

    #(TCK*10);
    TB_RESET <= 1'b1; #40; TB_RESET <= 1'b0; #(TCK*3);

    // =========================================================
    // TEST 1: SPI Load Image (10 × 30b)
    // =========================================================
    $display("\n--- TEST 1: SPI LOAD IMAGE (10 filas × 30 bits, cmd 001) ---");
    test_image[0]=30'h00000001; test_image[1]=30'h00000249;
    test_image[2]=30'h3FFFFFFF; test_image[3]=30'h15555555;
    test_image[4]=30'h00000000; test_image[5]=30'h09249249;
    test_image[6]=30'h1BBBBBBB; test_image[7]=30'h0AAAAAAA;
    test_image[8]=30'h12345678; test_image[9]=30'h0FEDCBA8;
    spi_load_image();
    $display("  imem[0]: %h (Exp: %h)", CNNver3_u0.spi_cnn_slave_8_u0.image_mem[0], test_image[0]);
    $display("  imem[5]: %h (Exp: %h)", CNNver3_u0.spi_cnn_slave_8_u0.image_mem[5], test_image[5]);
    $display("  imem[9]: %h (Exp: %h)", CNNver3_u0.spi_cnn_slave_8_u0.image_mem[9], test_image[9]);
    $display("  Reg0:    %h (Exp: %h)", CNNver3_u0.register_imag_u0.Register_Imag_DataOutBUS, test_image[0]);
    $display("  Reg9:    %h (Exp: %h)", CNNver3_u0.register_imag_u9.Register_Imag_DataOutBUS, test_image[9]);
    if (CNNver3_u0.spi_cnn_slave_8_u0.image_mem[0] === test_image[0] &&
        CNNver3_u0.spi_cnn_slave_8_u0.image_mem[9] === test_image[9] &&
        CNNver3_u0.register_imag_u0.Register_Imag_DataOutBUS === test_image[0] &&
        CNNver3_u0.register_imag_u1.Register_Imag_DataOutBUS === test_image[1] &&
        CNNver3_u0.register_imag_u2.Register_Imag_DataOutBUS === test_image[2] &&
        CNNver3_u0.register_imag_u3.Register_Imag_DataOutBUS === test_image[3] &&
        CNNver3_u0.register_imag_u4.Register_Imag_DataOutBUS === test_image[4] &&
        CNNver3_u0.register_imag_u5.Register_Imag_DataOutBUS === test_image[5] &&
        CNNver3_u0.register_imag_u6.Register_Imag_DataOutBUS === test_image[6] &&
        CNNver3_u0.register_imag_u7.Register_Imag_DataOutBUS === test_image[7] &&
        CNNver3_u0.register_imag_u8.Register_Imag_DataOutBUS === test_image[8] &&
        CNNver3_u0.register_imag_u9.Register_Imag_DataOutBUS === test_image[9])
        begin $display("  >> TEST 1 PASSED"); pass_count=pass_count+1; end
    else begin $display("  >> TEST 1 FAILED"); fail_count=fail_count+1; end

    // =========================================================
    // TEST 2: SPI Load Weights (5 × 15b)
    // =========================================================
    $display("\n--- TEST 2: SPI LOAD WEIGHTS (5 filas × 15 bits, cmd 010) ---");
    test_weight[0]=15'h0001; test_weight[1]=15'h0249;
    test_weight[2]=15'h1FFF; test_weight[3]=15'h06DB; test_weight[4]=15'h0000;
    spi_load_weights();
    $display("  wmem[0]: %h (Exp: %h)", CNNver3_u0.spi_cnn_slave_8_u0.weight_mem[0], test_weight[0]);
    $display("  wmem[4]: %h (Exp: %h)", CNNver3_u0.spi_cnn_slave_8_u0.weight_mem[4], test_weight[4]);
    $display("  WReg0:   %h (Exp: %h)", CNNver3_u0.weight_register_u0.Register_Weight_DataOutBUS, test_weight[0]);
    $display("  WReg4:   %h (Exp: %h)", CNNver3_u0.weight_register_u4.Register_Weight_DataOutBUS, test_weight[4]);
    if (CNNver3_u0.spi_cnn_slave_8_u0.weight_mem[0] === test_weight[0] &&
        CNNver3_u0.spi_cnn_slave_8_u0.weight_mem[1] === test_weight[1] &&
        CNNver3_u0.spi_cnn_slave_8_u0.weight_mem[2] === test_weight[2] &&
        CNNver3_u0.spi_cnn_slave_8_u0.weight_mem[3] === test_weight[3] &&
        CNNver3_u0.spi_cnn_slave_8_u0.weight_mem[4] === test_weight[4] &&
        CNNver3_u0.weight_register_u0.Register_Weight_DataOutBUS === test_weight[0] &&
        CNNver3_u0.weight_register_u4.Register_Weight_DataOutBUS === test_weight[4])
        begin $display("  >> TEST 2 PASSED"); pass_count=pass_count+1; end
    else begin $display("  >> TEST 2 FAILED"); fail_count=fail_count+1; end

    // =========================================================
    // TEST 3: CNN ceros — imagen=0, pesos=0 → MR1=0, MR2=0, comp=0
    // =========================================================
    $display("\n--- TEST 3: CNN flujo completo - Todo Ceros ---");
    TB_RESET <= 1'b1; #40; TB_RESET <= 1'b0; #(TCK*3);
    for (ii=0; ii<IMG_ROWS; ii=ii+1) test_image[ii]  = 30'h00000000;
    for (ii=0; ii<WGT_ROWS; ii=ii+1) test_weight[ii] = 15'h0000;
    // Kernel 0 (pesos=0)
    spi_load_image(); spi_load_weights(); spi_start_cnn(); esperar_mr1_load();
    // Kernel 1 (pesos=0, reutiliza test_weight)
    spi_load_weights(); spi_start_cnn(); esperar_mr2_load();
    $display("  MR1=%0d (Exp:0)  MR2=%0d (Exp:0)  comp=%b (Exp:0)",
        $signed(CNNver3_u0.MR1_out_cwire),
        $signed(CNNver3_u0.MR2_out_cwire),
        CNNver3_u0.comp_result_cwire);
    if ($signed(CNNver3_u0.MR1_out_cwire) === 16'sd0 &&
        $signed(CNNver3_u0.MR2_out_cwire) === 16'sd0 &&
        CNNver3_u0.comp_result_cwire === 1'b0)
        begin $display("  >> TEST 3 PASSED"); pass_count=pass_count+1; end
    else begin $display("  >> TEST 3 FAILED"); fail_count=fail_count+1; end

    // =========================================================
    // TEST 4: CNN -1/-1 → acc = +25/ventana, MR1=MR2 → comp=0
    // Imagen: todos -1 = 3'b111 → 30 bits = 30'h3FFFFFFF
    // Pesos:  todos -1 = 3'b111 → 15 bits = 15'h7FFF
    // Conv: (-1)*(-1)*25 = +25 por ventana → maxpool=+25 por frag
    // acc = 9*25 = +225
    // =========================================================
    $display("\n--- TEST 4: CNN imagen=-1 pesos=-1 (Exp: MR1=+225, MR2=+225, comp=0) ---");
    TB_RESET <= 1'b1; #40; TB_RESET <= 1'b0; #(TCK*3);
    for (ii=0; ii<IMG_ROWS; ii=ii+1) test_image[ii]  = 30'h3FFFFFFF;
    for (ii=0; ii<WGT_ROWS; ii=ii+1) test_weight[ii] = 15'h7FFF;
    spi_load_image(); spi_load_weights(); spi_start_cnn(); esperar_mr1_load();
    spi_load_weights(); spi_start_cnn(); esperar_mr2_load();
    $display("  MR1=%0d (Exp:+225)  MR2=%0d (Exp:+225)  comp=%b (Exp:0)",
        $signed(CNNver3_u0.MR1_out_cwire),
        $signed(CNNver3_u0.MR2_out_cwire),
        CNNver3_u0.comp_result_cwire);
    if ($signed(CNNver3_u0.MR1_out_cwire) === 16'sd225 &&
        $signed(CNNver3_u0.MR2_out_cwire) === 16'sd225 &&
        CNNver3_u0.comp_result_cwire === 1'b0)
        begin $display("  >> TEST 4 PASSED"); pass_count=pass_count+1; end
    else begin $display("  >> TEST 4 FAILED"); fail_count=fail_count+1; end

    // =========================================================
    // TEST 5: CNN +1/+1 → MR1=+225, MR2=+225, comp=0
    // Imagen: todos +1 = 3'b001 → 30'h09249249
    // Pesos:  todos +1 = 3'b001 → 15'h1249
    // =========================================================
    $display("\n--- TEST 5: CNN imagen=+1 pesos=+1 (Exp: MR1=+225, MR2=+225, comp=0) ---");
    TB_RESET <= 1'b1; #40; TB_RESET <= 1'b0; #(TCK*3);
    for (ii=0; ii<IMG_ROWS; ii=ii+1) test_image[ii]  = 30'h09249249;
    for (ii=0; ii<WGT_ROWS; ii=ii+1) test_weight[ii] = 15'h1249;
    spi_load_image(); spi_load_weights(); spi_start_cnn(); esperar_mr1_load();
    spi_load_weights(); spi_start_cnn(); esperar_mr2_load();
    $display("  MR1=%0d (Exp:+225)  MR2=%0d (Exp:+225)  comp=%b (Exp:0)",
        $signed(CNNver3_u0.MR1_out_cwire),
        $signed(CNNver3_u0.MR2_out_cwire),
        CNNver3_u0.comp_result_cwire);
    if ($signed(CNNver3_u0.MR1_out_cwire) === 16'sd225 &&
        $signed(CNNver3_u0.MR2_out_cwire) === 16'sd225 &&
        CNNver3_u0.comp_result_cwire === 1'b0)
        begin $display("  >> TEST 5 PASSED"); pass_count=pass_count+1; end
    else begin $display("  >> TEST 5 FAILED"); fail_count=fail_count+1; end

    // =========================================================
    // TEST 6: Flujo doble kernel diferente: K0=+1→MR1=+225, K1=-1→MR2=-225
    // Imagen: todos +1, Kernel0: todos +1, Kernel1: todos -1 = 15'h7FFF
    // MR1>MR2 → comp=1
    // =========================================================
    $display("\n--- TEST 6: K0=+1→MR1=+225, K1=-1→MR2=-225, comp=1 ---");
    TB_RESET <= 1'b1; #40; TB_RESET <= 1'b0; #(TCK*3);
    for (ii=0; ii<IMG_ROWS; ii=ii+1) test_image[ii]  = 30'h09249249;  // imagen +1
    for (ii=0; ii<WGT_ROWS; ii=ii+1) test_weight[ii] = 15'h1249;      // kernel0 +1
    spi_load_image(); spi_load_weights(); spi_start_cnn(); esperar_mr1_load();
    $display("  MR1=%0d (Exp:+225)", $signed(CNNver3_u0.MR1_out_cwire));
    for (ii=0; ii<WGT_ROWS; ii=ii+1) test_weight[ii] = 15'h7FFF;      // kernel1 -1
    spi_load_weights(); spi_start_cnn(); esperar_mr2_load();
    $display("  MR2=%0d (Exp:-225)", $signed(CNNver3_u0.MR2_out_cwire));
    $display("  comp=%b (Exp:1)", CNNver3_u0.comp_result_cwire);
    if ($signed(CNNver3_u0.MR1_out_cwire) === 16'sd225 &&
        $signed(CNNver3_u0.MR2_out_cwire) === -16'sd225 &&
        CNNver3_u0.comp_result_cwire === 1'b1)
        begin $display("  >> TEST 6 PASSED"); pass_count=pass_count+1; end
    else begin $display("  >> TEST 6 FAILED"); fail_count=fail_count+1; end

    // =========================================================
    // TEST 7: Flujo inverso: K0=-1→MR1=-225, K1=+1→MR2=+225, comp=0
    // =========================================================
    $display("\n--- TEST 7: K0=-1→MR1=-225, K1=+1→MR2=+225, comp=0 ---");
    TB_RESET <= 1'b1; #40; TB_RESET <= 1'b0; #(TCK*3);
    for (ii=0; ii<IMG_ROWS; ii=ii+1) test_image[ii]  = 30'h09249249;  // imagen +1
    for (ii=0; ii<WGT_ROWS; ii=ii+1) test_weight[ii] = 15'h7FFF;      // kernel0 -1
    spi_load_image(); spi_load_weights(); spi_start_cnn(); esperar_mr1_load();
    $display("  MR1=%0d (Exp:-225)", $signed(CNNver3_u0.MR1_out_cwire));
    for (ii=0; ii<WGT_ROWS; ii=ii+1) test_weight[ii] = 15'h1249;      // kernel1 +1
    spi_load_weights(); spi_start_cnn(); esperar_mr2_load();
    $display("  MR2=%0d (Exp:+225)", $signed(CNNver3_u0.MR2_out_cwire));
    $display("  comp=%b (Exp:0)", CNNver3_u0.comp_result_cwire);
    if ($signed(CNNver3_u0.MR1_out_cwire) === -16'sd225 &&
        $signed(CNNver3_u0.MR2_out_cwire) === 16'sd225 &&
        CNNver3_u0.comp_result_cwire === 1'b0)
        begin $display("  >> TEST 7 PASSED"); pass_count=pass_count+1; end
    else begin $display("  >> TEST 7 FAILED"); fail_count=fail_count+1; end

    // =========================================================
    // TEST 8: CNN patron mixto arbitrario con compute_expected
    // =========================================================
    $display("\n--- TEST 8: CNN patron mixto arbitrario ---");
    TB_RESET <= 1'b1; #40; TB_RESET <= 1'b0; #(TCK*3);
    test_image[0]=30'h2A5A5A5A; test_image[1]=30'h13C3C3C3;
    test_image[2]=30'h0A96969A; test_image[3]=30'h3FFFFFFF;
    test_image[4]=30'h00000000; test_image[5]=30'h155D55D5;
    test_image[6]=30'h2AAAAAAA; test_image[7]=30'h00000001;
    test_image[8]=30'h12481248; test_image[9]=30'h0DB6DB6D;
    test_weight[0]=15'h16B5; test_weight[1]=15'h0492;
    test_weight[2]=15'h7FFF; test_weight[3]=15'h0000; test_weight[4]=15'h36DB;
    spi_load_image(); spi_load_weights(); spi_start_cnn(); esperar_mr1_load();
    // Segundo kernel igual para este test
    spi_load_weights(); spi_start_cnn(); esperar_mr2_load();
    $display("  MR1=%0d  MR2=%0d (deben ser iguales, mismo kernel)",
        $signed(CNNver3_u0.MR1_out_cwire),
        $signed(CNNver3_u0.MR2_out_cwire));
    if ($signed(CNNver3_u0.MR1_out_cwire) === $signed(CNNver3_u0.MR2_out_cwire))
        begin $display("  >> TEST 8 PASSED"); pass_count=pass_count+1; end
    else begin $display("  >> TEST 8 FAILED"); fail_count=fail_count+1; end

    // =========================================================
    // TEST 9: Weight registers post-CNN intactos
    // =========================================================
    $display("\n--- TEST 9: Weight registers post-CNN ---");
    $display("  WReg0: %h (Exp: %h)", CNNver3_u0.weight_register_u0.Register_Weight_DataOutBUS, test_weight[0]);
    $display("  WReg4: %h (Exp: %h)", CNNver3_u0.weight_register_u4.Register_Weight_DataOutBUS, test_weight[4]);
    if (CNNver3_u0.weight_register_u0.Register_Weight_DataOutBUS === test_weight[0] &&
        CNNver3_u0.weight_register_u1.Register_Weight_DataOutBUS === test_weight[1] &&
        CNNver3_u0.weight_register_u2.Register_Weight_DataOutBUS === test_weight[2] &&
        CNNver3_u0.weight_register_u3.Register_Weight_DataOutBUS === test_weight[3] &&
        CNNver3_u0.weight_register_u4.Register_Weight_DataOutBUS === test_weight[4])
        begin $display("  >> TEST 9 PASSED"); pass_count=pass_count+1; end
    else begin $display("  >> TEST 9 FAILED"); fail_count=fail_count+1; end

    // =========================================================
    // TEST 10: FSM CNN Controller — retorna a IDLE tras ciclo completo
    // =========================================================
    $display("\n--- TEST 10: FSM CNN Controller regresa a IDLE ---");
    for (ii=0; ii<IMG_ROWS; ii=ii+1) test_image[ii]  = 30'h09249249;
    for (ii=0; ii<WGT_ROWS; ii=ii+1) test_weight[ii] = 15'h1249;
    TB_RESET <= 1'b1; #40; TB_RESET <= 1'b0; #(TCK*3);
    spi_load_image(); spi_load_weights(); spi_start_cnn(); esperar_mr1_load();
    spi_load_weights(); spi_start_cnn(); esperar_mr2_load();
    #(TCK*5);
    $display("  FSM state = %0d (Exp: IDLE=0)", CNNver3_u0.cnn_ctrl_u0.state);
    if (CNNver3_u0.cnn_ctrl_u0.state === 4'd0)
        begin $display("  >> TEST 10 PASSED"); pass_count=pass_count+1; end
    else begin $display("  >> TEST 10 FAILED (state=%0d)", CNNver3_u0.cnn_ctrl_u0.state); fail_count=fail_count+1; end

    // =========================================================
    // TEST 11: image_mem interno SPI con patron incremental
    // =========================================================
    $display("\n--- TEST 11: image_mem interno SPI (patron incremental) ---");
    for (ii=0; ii<IMG_ROWS; ii=ii+1) test_image[ii] = 30'h09249249 + ii;
    spi_load_image();
    $display("  imem[0]: %h (Exp: %h)", CNNver3_u0.spi_cnn_slave_8_u0.image_mem[0], test_image[0]);
    $display("  imem[5]: %h (Exp: %h)", CNNver3_u0.spi_cnn_slave_8_u0.image_mem[5], test_image[5]);
    $display("  imem[9]: %h (Exp: %h)", CNNver3_u0.spi_cnn_slave_8_u0.image_mem[9], test_image[9]);
    if (CNNver3_u0.spi_cnn_slave_8_u0.image_mem[0] === test_image[0] &&
        CNNver3_u0.spi_cnn_slave_8_u0.image_mem[4] === test_image[4] &&
        CNNver3_u0.spi_cnn_slave_8_u0.image_mem[9] === test_image[9])
        begin $display("  >> TEST 11 PASSED"); pass_count=pass_count+1; end
    else begin $display("  >> TEST 11 FAILED"); fail_count=fail_count+1; end

    // =========================================================
    // TEST 12: weight_mem interno SPI con patron incremental
    // =========================================================
    $display("\n--- TEST 12: weight_mem interno SPI (patron incremental) ---");
    for (ii=0; ii<WGT_ROWS; ii=ii+1) test_weight[ii] = 15'h0249 + ii;
    spi_load_weights();
    $display("  wmem[0]: %h (Exp: %h)", CNNver3_u0.spi_cnn_slave_8_u0.weight_mem[0], test_weight[0]);
    $display("  wmem[4]: %h (Exp: %h)", CNNver3_u0.spi_cnn_slave_8_u0.weight_mem[4], test_weight[4]);
    if (CNNver3_u0.spi_cnn_slave_8_u0.weight_mem[0] === test_weight[0] &&
        CNNver3_u0.spi_cnn_slave_8_u0.weight_mem[2] === test_weight[2] &&
        CNNver3_u0.spi_cnn_slave_8_u0.weight_mem[4] === test_weight[4])
        begin $display("  >> TEST 12 PASSED"); pass_count=pass_count+1; end
    else begin $display("  >> TEST 12 FAILED"); fail_count=fail_count+1; end

    // =========================================================
    // TEST 13: READ MR1 via MISO (cmd 101, 16 bits)
    // =========================================================
    $display("\n--- TEST 13: READ MR1 via MISO (cmd 101) ---");
    TB_RESET <= 1'b1; #40; TB_RESET <= 1'b0; #(TCK*3);
    for (ii=0; ii<IMG_ROWS; ii=ii+1) test_image[ii]  = 30'h09249249;
    for (ii=0; ii<WGT_ROWS; ii=ii+1) test_weight[ii] = 15'h1249;
    spi_load_image(); spi_load_weights(); spi_start_cnn(); esperar_mr1_load();
    for (ii=0; ii<WGT_ROWS; ii=ii+1) test_weight[ii] = 15'h7FFF;
    spi_load_weights(); spi_start_cnn(); esperar_mr2_load();
    // MR1 debe ser +225
    spi_read_mr1();
    $display("  MR1 interno=%0d  MISO capturado=%0d (Exp: +225)",
        $signed(CNNver3_u0.MR1_out_cwire), $signed(miso_mr1));
    if ($signed(CNNver3_u0.MR1_out_cwire) === 16'sd225 &&
        $signed(miso_mr1) === 16'sd225)
        begin $display("  >> TEST 13 PASSED"); pass_count=pass_count+1; end
    else begin $display("  >> TEST 13 FAILED"); fail_count=fail_count+1; end

    // =========================================================
    // TEST 14: READ MR2 via MISO (cmd 110, 16 bits)
    // =========================================================
    $display("\n--- TEST 14: READ MR2 via MISO (cmd 110) ---");
    // MR2 del run anterior debe ser -225 (kernel=-1, imagen=+1)
    spi_read_mr2();
    $display("  MR2 interno=%0d  MISO capturado=%0d (Exp: -225)",
        $signed(CNNver3_u0.MR2_out_cwire), $signed(miso_mr2));
    if ($signed(CNNver3_u0.MR2_out_cwire) === -16'sd225 &&
        $signed(miso_mr2) === -16'sd225)
        begin $display("  >> TEST 14 PASSED"); pass_count=pass_count+1; end
    else begin $display("  >> TEST 14 FAILED"); fail_count=fail_count+1; end

    // =========================================================
    // TEST 15: READ RESULT via MISO — cmd 100, 1 bit comparador
    // MR1=+225, MR2=-225 → comp=1
    // =========================================================
    $display("\n--- TEST 15: READ RESULT via MISO (cmd 100, 1 bit) ---");
    $display("  comp_result interno = %b (Exp: 1)", CNNver3_u0.comp_result_cwire);
    spi_read_compare();
    $display("  MISO capturado = %b (Exp: 1)", comp_captured);
    if (CNNver3_u0.comp_result_cwire === 1'b1 && comp_captured === 1'b1)
        begin $display("  >> TEST 15 PASSED"); pass_count=pass_count+1; end
    else begin $display("  >> TEST 15 FAILED"); fail_count=fail_count+1; end

    // =========================================================
    // TEST 16: SS_N sube a mitad de fila → fila NO debe guardarse
    // (reemplaza TEST 16 de CNNver2 que usaba cmd_reset)
    // Con CNNver3 el reset de transacción lo hace SS_N=1:
    // internal_reset = i_SPI_CS_n | i_cmd_reset = i_SPI_CS_n | 0 = i_SPI_CS_n
    // Si SS_N sube a mitad de fila, bit_count y row se resetean.
    // image_mem[0] NO debe cambiar (la fila no estaba completa).
    // =========================================================
    $display("\n--- TEST 16: SS_N sube a mitad de fila (sin cmd_reset) ---");
    for (ii=0; ii<IMG_ROWS; ii=ii+1) test_image[ii] = 30'h09249249;
    spi_load_image();
    $display("  Imagen cargada: imem[0]=%h", CNNver3_u0.spi_cnn_slave_8_u0.image_mem[0]);

    // Iniciar LOAD IMAGE pero SS_N sube a la mitad de fila 0 (15 bits)
    @(negedge TB_CLK); #2; TB_SS_N <= 1'b0;
    send_cmd(3'b001);
    for (jj = 29; jj >= 15; jj = jj - 1) begin
        @(negedge TB_CLK); #2; TB_MOSI <= 1'b1;
        @(posedge TB_CLK); #1;
    end
    // Subir SS_N a mitad de fila (bit_count ~ 18, fila NO completada)
    @(negedge TB_CLK); #2;
    $display("  Subiendo SS_N a mitad de fila (15 bits de 30 enviados)...");
    TB_SS_N <= 1'b1;
    #(TCK*5);
    $display("  bit_count=%0d (Exp:0), row=%0d (Exp:0)",
        CNNver3_u0.spi_cnn_slave_8_u0.bit_count,
        CNNver3_u0.spi_cnn_slave_8_u0.row);
    $display("  imem[0]=%h (Exp: %h — intacto)",
        CNNver3_u0.spi_cnn_slave_8_u0.image_mem[0], test_image[0]);
    if (CNNver3_u0.spi_cnn_slave_8_u0.bit_count === 9'd0 &&
        CNNver3_u0.spi_cnn_slave_8_u0.row === 4'd0 &&
        CNNver3_u0.spi_cnn_slave_8_u0.image_mem[0] === test_image[0])
        begin $display("  >> TEST 16 PASSED"); pass_count=pass_count+1; end
    else begin $display("  >> TEST 16 FAILED"); fail_count=fail_count+1; end

    // =========================================================
    // TEST 17: Comparador MR1 > MR2 → comp=1
    // =========================================================
    $display("\n--- TEST 17: Comparador MR1>MR2 → comp=1 ---");
    // Del estado actual: MR1=+225, MR2=-225
    $display("  MR1=%0d  MR2=%0d  comp_result=%b (Exp:1)",
        $signed(CNNver3_u0.MR1_out_cwire),
        $signed(CNNver3_u0.MR2_out_cwire),
        CNNver3_u0.comp_result_cwire);
    if (CNNver3_u0.comp_result_cwire === 1'b1)
        begin $display("  >> TEST 17 PASSED"); pass_count=pass_count+1; end
    else begin $display("  >> TEST 17 FAILED"); fail_count=fail_count+1; end

    // =========================================================
    // TEST 18: Comparador MR1 < MR2 → comp=0
    // =========================================================
    $display("\n--- TEST 18: Comparador MR1<MR2 → comp=0 ---");
    TB_RESET <= 1'b1; #40; TB_RESET <= 1'b0; #(TCK*3);
    for (ii=0; ii<IMG_ROWS; ii=ii+1) test_image[ii]  = 30'h09249249;
    for (ii=0; ii<WGT_ROWS; ii=ii+1) test_weight[ii] = 15'h7FFF; // K0=-1 → MR1=-225
    spi_load_image(); spi_load_weights(); spi_start_cnn(); esperar_mr1_load();
    for (ii=0; ii<WGT_ROWS; ii=ii+1) test_weight[ii] = 15'h1249; // K1=+1 → MR2=+225
    spi_load_weights(); spi_start_cnn(); esperar_mr2_load();
    $display("  MR1=%0d  MR2=%0d  comp_result=%b (Exp:0)",
        $signed(CNNver3_u0.MR1_out_cwire),
        $signed(CNNver3_u0.MR2_out_cwire),
        CNNver3_u0.comp_result_cwire);
    if (CNNver3_u0.comp_result_cwire === 1'b0)
        begin $display("  >> TEST 18 PASSED"); pass_count=pass_count+1; end
    else begin $display("  >> TEST 18 FAILED"); fail_count=fail_count+1; end

    // =========================================================
    // TEST 19: Comparador MR1 = MR2 → comp=0  (iguales → no mayor)
    // =========================================================
    $display("\n--- TEST 19: Comparador MR1=MR2 → comp=0 ---");
    TB_RESET <= 1'b1; #40; TB_RESET <= 1'b0; #(TCK*3);
    for (ii=0; ii<IMG_ROWS; ii=ii+1) test_image[ii]  = 30'h09249249;
    for (ii=0; ii<WGT_ROWS; ii=ii+1) test_weight[ii] = 15'h1249; // K0=+1 → MR1=+225
    spi_load_image(); spi_load_weights(); spi_start_cnn(); esperar_mr1_load();
    // K1 igual → MR2=+225
    spi_load_weights(); spi_start_cnn(); esperar_mr2_load();
    $display("  MR1=%0d  MR2=%0d  comp_result=%b (Exp:0)",
        $signed(CNNver3_u0.MR1_out_cwire),
        $signed(CNNver3_u0.MR2_out_cwire),
        CNNver3_u0.comp_result_cwire);
    if (CNNver3_u0.comp_result_cwire === 1'b0)
        begin $display("  >> TEST 19 PASSED"); pass_count=pass_count+1; end
    else begin $display("  >> TEST 19 FAILED"); fail_count=fail_count+1; end

    // =========================================================
    // TEST 20: FSM WAIT_K1 — segundo START llega correctamente
    // Verifica que la FSM esté en WAIT_K1 entre los dos STARTs
    // y que transite a LATCH_K1 al recibir el segundo START.
    // =========================================================
    $display("\n--- TEST 20: FSM WAIT_K1 — segundo START correcto ---");
    TB_RESET <= 1'b1; #40; TB_RESET <= 1'b0; #(TCK*3);
    for (ii=0; ii<IMG_ROWS; ii=ii+1) test_image[ii]  = 30'h09249249;
    for (ii=0; ii<WGT_ROWS; ii=ii+1) test_weight[ii] = 15'h1249;
    spi_load_image(); spi_load_weights(); spi_start_cnn(); esperar_mr1_load();
    $display("  FSM state post-MR1_load = %0d (Exp: WAIT_K1=6)",
        CNNver3_u0.cnn_ctrl_u0.state);
    for (ii=0; ii<WGT_ROWS; ii=ii+1) test_weight[ii] = 15'h7FFF;
    spi_load_weights();
    $display("  FSM state antes del segundo START = %0d (Exp: WAIT_K1=6)",
        CNNver3_u0.cnn_ctrl_u0.state);
    spi_start_cnn(); esperar_mr2_load();
    $display("  MR2=%0d (Exp:-225)", $signed(CNNver3_u0.MR2_out_cwire));
    $display("  FSM state final = %0d (Exp: IDLE=0)", CNNver3_u0.cnn_ctrl_u0.state);
    if (CNNver3_u0.cnn_ctrl_u0.state === 4'd0 &&
        $signed(CNNver3_u0.MR2_out_cwire) === -16'sd225)
        begin $display("  >> TEST 20 PASSED"); pass_count=pass_count+1; end
    else begin $display("  >> TEST 20 FAILED"); fail_count=fail_count+1; end

    // =========================================================
    // RESUMEN FINAL
    // =========================================================
    $display("\n===================================================");
    $display("  RESULTADOS: %0d PASS  |  %0d FAIL", pass_count, fail_count);
    if (fail_count == 0)
        $display("  ALL TESTS PASSED");
    else
        $display("  SOME TESTS FAILED -- revisar ondas");
    $display("===================================================");

    #(TCK*5);
    $finish;
end

// ============================================================
//  MONITORES — Eventos clave en tiempo real
// ============================================================
always @(negedge CNNver3_u0.CNN_CTRL_mr1_load_cwire)
    $display("  [MON] t=%0t mr1_load↓ → acc0=%0d guardado en MR1",
             $time, $signed(CNNver3_u0.cnn_ctrl_u0.o_acc0));

always @(negedge CNNver3_u0.CNN_CTRL_mr2_load_cwire)
    $display("  [MON] t=%0t mr2_load↓ → acc1=%0d guardado en MR2",
             $time, $signed(CNNver3_u0.cnn_ctrl_u0.o_acc1));

always @(posedge CNNver3_u0.SPI_2_CNN_Start_cwire)
    $display("  [MON] t=%0t START_CNN recibido, FSM state=%0d",
             $time, CNNver3_u0.cnn_ctrl_u0.state);

always @(posedge CNNver3_u0.cnn_ctrl_u0.cnn_inst.done)
    $display("  [MON] t=%0t cnn_top done, acc=%0d frag_sel=%0d",
             $time, $signed(CNNver3_u0.cnn_ctrl_u0.cnn_inst.acc),
             CNNver3_u0.cnn_ctrl_u0.cnn_inst.frag_sel);

endmodule
